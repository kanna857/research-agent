# KnowSure Environment Configuration

# Backend Core
APP_NAME=KnowSure
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=knowsure_secret_key_change_in_production_32bytes!

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
# PostgreSQL connection string: postgresql+asyncpg://user:password@localhost:5432/knowsure
# Fallback SQLite async string for dev: sqlite+aiosqlite:///./knowsure.db
DATABASE_URL=sqlite+aiosqlite:///./knowsure.db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=knowsure_password

# Academic APIs (Optional API keys for higher rate limits)
OPENALEX_EMAIL=researcher@knowsure.ai
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_USER_AGENT=KnowSure-ResearchAgent/1.0

# n8n Orchestration
N8N_BASE_URL=http://localhost:5678
N8N_RESEARCH_WEBHOOK=http://localhost:5678/webhook/knowsure-research
N8N_API_KEY=knowsure_n8n_secret_token

# LLM / Embedding Providers (Configurable)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
